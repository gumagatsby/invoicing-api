<mxfile host="drawio"><diagram name="Invoicing API: containers"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1040" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="1040" as="geometry"/></mxCell><mxCell id="c4" value="Invoicing and payments API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c5" value="Container diagram (C4 level 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="900" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Merchant&lt;br&gt;(signs in to the dashboard)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="64" y="236" width="30" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Merchant&#x27;s own systems&lt;br&gt;(call the API directly)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="64" y="470" width="30" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Invoicing system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="1000" height="640" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[React, TypeScript, nginx]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Invoices, payments, ledger&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="220" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Python, FastAPI]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Auth, invoices, idempotent payments, double-entry ledger, rate limits&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="260" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Python, arq]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Sends due webhooks every 5 s; retries with backoff, then marks failed&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="260" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[PostgreSQL 17]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Invoices, payments, ledger, webhook outbox&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="190" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Redis 7]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Rate-limit counters; worker scheduling&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="190" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Merchant&amp;#x27;s webhook endpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[HTTPS]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Verifies the signature, de-duplicates by event id&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1300" y="560" width="250" height="110" as="geometry"/></mxCell><mxCell id="c15" value="Observability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontColor=#545B64;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="790" width="1000" height="200" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Jaeger, OpenTelemetry]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Every request and SQL statement&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="240" y="840" width="240" height="96" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Metrics&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Prometheus]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Scrapes the API and worker every 5 s&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="840" width="260" height="96" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Dashboards&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#545B64&#x27;&gt;[Grafana]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Provisioned from code&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;fontColor=#232F3E;fontSize=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="840" width="190" height="96" as="geometry"/></mxCell><mxCell id="c19" value="Uses&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="REST calls&lt;br&gt;[JWT, Idempotency-Key]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="498"/><mxPoint x="510" y="300"/></Array></mxGeometry></mxCell><mxCell id="c21" value="JSON&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Reads and writes&lt;br&gt;[SQL, row locks]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Counts requests&lt;br&gt;[INCR]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="306"/><mxPoint x="900" y="464"/></Array></mxGeometry></mxCell><mxCell id="c24" value="Reads due&lt;br&gt;outbox rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="593"/><mxPoint x="1180" y="230"/></Array></mxGeometry></mxCell><mxCell id="c25" value="POST event&lt;br&gt;[HMAC-SHA256 signed]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Traces&lt;br&gt;[OTLP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="525"/><mxPoint x="538" y="525"/><mxPoint x="538" y="765"/><mxPoint x="360" y="765"/></Array></mxGeometry></mxCell><mxCell id="c27" value="Queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#879196;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="What it guarantees" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="420" height="22" as="geometry"/></mxCell><mxCell id="c29" value="A retried payment never charges twice: idempotency key, unique in the database." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="152" width="420" height="50" as="geometry"/></mxCell><mxCell id="c30" value="Two payments at once cannot overpay: the invoice row is locked, and a CHECK constraint backs it up." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="206" width="420" height="50" as="geometry"/></mxCell><mxCell id="c31" value="Every movement of money is an equal debit and credit, append-only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="260" width="420" height="50" as="geometry"/></mxCell><mxCell id="c32" value="Webhooks are written in the same transaction as the payment, so none are lost, and each is signed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="314" width="420" height="50" as="geometry"/></mxCell><mxCell id="c33" value="Measured" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="374" width="420" height="20" as="geometry"/></mxCell><mxCell id="c34" value="k6, 20 users for 60 s, every SQL statement traced: 10,734 requests, 0 errors, payments p95 129 ms. 20 parallel retries of one payment created exactly one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="396" width="420" height="56" as="geometry"/></mxCell><mxCell id="c35" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="900" width="420" height="20" as="geometry"/></mxCell><mxCell id="c36" value="Solid: request path&lt;br&gt;Dashed grey: telemetry&lt;br&gt;Grey border: outside the system" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1300" y="922" width="420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>